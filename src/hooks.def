// Function-entry hooks. One line each:  HOOK(name, entry_va, "first instruction")
// tools/inject.py builds a stub per line (in this order) and checks the first instruction.
// In C, define:  RValue *hook_<name>(CInstance *self, CInstance *other, RValue *res, int argc, RValue **argv)
// and call the original with ORIG(name)(self, other, res, argc, argv).
// The first instruction must not be PC-relative (adr/adrp/b/bl/cbz/ldr literal).

HOOK(change_possession, 0x10010aca8, "sub sp, sp, #0x150")
HOOK(update_commentary, 0x1005ab618, "stp d11, d10, [sp, #-0x80]!")
HOOK(slog, 0x10062b030, "sub sp, sp, #0xe0")
HOOK(action_result, 0x1000f7200, "stp d11, d10, [sp, #-0x80]!")
HOOK(update_ball, 0x1005a3898, "stp d11, d10, [sp, #-0x80]!")
HOOK(get_destination, 0x1003b77ac, "sub sp, sp, #0x1a0")
HOOK(player_draw, 0x100764a4c, "stp d15, d14, [sp, #-0xa0]!")
HOOK(create_message, 0x100312cb4, "stp d9, d8, [sp, #-0x70]!")
HOOK(msg_clear, 0x100475d8c, "stp d9, d8, [sp, #-0x70]!")
HOOK(camera_step2, 0x1006c1df8, "stp d13, d12, [sp, #-0x90]!")
HOOK(controller_gui, 0x1006e05c8, "stp d9, d8, [sp, #-0x70]!")
HOOK(ball_draw, 0x10068dc68, "sub sp, sp, #0x1c0")
HOOK(fieldtxt_draw, 0x1006f1a48, "stp d13, d12, [sp, #-0x90]!")
